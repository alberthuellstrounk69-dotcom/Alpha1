# ---------------------------------------------------------------------------
# Velocity Token — example environment file.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Private key of the deployer account (0x-prefixed, 32-byte hex).
# Use a dedicated, freshly generated deployment key — never a personal wallet.
DEPLOYER_PRIVATE_KEY=

# RPC provider keys (set at least one to reach public networks).
INFURA_API_KEY=
ALCHEMY_API_KEY=

# Contract verification.
ETHERSCAN_API_KEY=

# Enable the gas reporter (true/false).
REPORT_GAS=false

# ---------------------------------------------------------------------------
# Deployment parameters (optional overrides for the deploy scripts).
# ---------------------------------------------------------------------------
# Address that receives treasury fees. Defaults to the deployer.
TREASURY_ADDRESS=

# Presale configuration.
TOKEN_ADDRESS=
PRESALE_PRICE=1000
PRESALE_START_DELAY=3600
PRESALE_DURATION=604800
HARD_CAP=100
SOFT_CAP=20
MIN_PURCHASE=0.01
MAX_PURCHASE=5
