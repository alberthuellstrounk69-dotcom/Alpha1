{
  "name": "velocity-token",
  "version": "1.0.0",
  "description": "Velocity Token (VELO) — production ERC-20 with transfer fees and a whitelist-capable presale/crowdsale.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol' 'scripts/**/*.js' 'test/**/*.js' '*.js'",
    "format:check": "prettier --check 'contracts/**/*.sol' 'scripts/**/*.js' 'test/**/*.js' '*.js'",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-token.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy-token.js --network sepolia",
    "deploy:presale:local": "hardhat run scripts/deploy-presale.js --network localhost",
    "deploy:presale:sepolia": "hardhat run scripts/deploy-presale.js --network sepolia",
    "balance": "hardhat run scripts/check-balance.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.17",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "solhint": "^5.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  }
}
